# Repos to monitor (owner/repo format, supports multiple owners)
GITHUB_REPOS=org1/repo-a,org1/repo-b,org2/repo-c

# Or single-owner legacy format:
# REPO_OWNER_NAME=my-org
# REPO_NAMES=repo-a,repo-b,repo-c

# Base URL of this service (used for OAuth callback URL)
# Must match the "Authorization callback URL" in your GitHub OAuth App settings
# Callback URL will be: {BASE_URL}/auth/github/callback
BASE_URL=http://localhost:9000

# GitHub Personal Access Token (for background sync and private repos)
GITHUB_ACCESS_TOKEN=ghp_xxxx

# GitHub OAuth2 (optional, enables "Sign in with GitHub")
# Create at: https://github.com/settings/applications/new
# Set "Authorization callback URL" to: {BASE_URL}/auth/github/callback
GITHUB_OAUTH2_CLIENT_ID=
GITHUB_OAUTH2_CLIENT_SECRET=

# Basic Auth (optional, enables username/password login)
# Create with: htpasswd -bnBC 10 <username> <password>
# BASIC_AUTH_USER_DETAILS_FILE_PATH=./htpasswd

# Session secret (change in production)
SESSION_SECRET=change-me-in-production

# Polling intervals
DISCOVERY_POLL_SECONDS=60
ACTIVE_POLL_SECONDS=10

# GitHub Webhooks (optional — enables real-time push updates)
# Set a webhook secret to enable. Reduces API polling to reconciliation-only.
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Smee.io proxy URL (optional — for containers behind NAT/firewalls)
# Create a channel at https://smee.io and paste the URL here.
# Requires: npm install smee-client
# SMEE_URL=https://smee.io/your-channel-id
